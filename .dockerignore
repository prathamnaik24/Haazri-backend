# ─── Docker Ignore ────────────────────────────────────────────────────────────
# Tells Docker which files NOT to copy into the build context.
# Keeps images lean and prevents secrets from leaking into images.
# ─────────────────────────────────────────────────────────────────────────────

# Dependencies — always reinstalled inside the container
node_modules
**/node_modules

# Build outputs
dist
**/dist
build
**/build

# Environment files — NEVER bake secrets into images
.env
.env.*
!.env.example

# Git
.git
.gitignore

# Logs
logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Editor configs
.vscode
.idea

# Docker files themselves (no need to copy into the image)
docker-compose.yml
docker/
