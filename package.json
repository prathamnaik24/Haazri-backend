{
  "name": "haazri-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node-pg-migrate -m database/migrations up",
    "db:migrate:down": "node-pg-migrate -m database/migrations down",
    "db:migrate:redo": "node-pg-migrate -m database/migrations redo",
    "db:create-migration": "node-pg-migrate -m database/migrations create",
    "db:seed": "node database/seeds/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "node-cron": "^4.6.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "node-pg-migrate": "^9.0.0",
    "nodemon": "^3.1.2",
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  }
}
