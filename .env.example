# Environment Configuration
NODE_ENV=development
PORT=5002

# Database Connection (Option A: Connection String - Preferred)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/attendance_db

# Database Connection (Option B: Individual DB_* variables - Alternative)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=attendance_db
# DB_USER=postgres
# DB_PASSWORD=your_password

# Authentication & JWT Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS & Frontend Origins
CORS_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Email Service Configuration (Optional — Resend)
# Leave BOTH empty to disable email for local dev.
# When disabled, the activation link is returned in the API response so admins
# can copy and share it manually without needing a verified sending domain.
# When both are set, Haazri will attempt to send the activation email via Resend.
# On send failure the API still succeeds and returns the fallback link to the admin.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
